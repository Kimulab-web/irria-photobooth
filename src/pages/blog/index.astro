---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const formatFr = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbs = [
  { name: 'Accueil', url: 'https://irria-photobooth.fr/' },
  { name: 'Blog', url: 'https://irria-photobooth.fr/blog/' },
];
---

<BaseLayout
  title="Blog Irria Photobooth"
  description="Conseils, inspirations et guides pour organiser votre événement au Pays Basque, dans les Landes et en Béarn. Mariages, séminaires, anniversaires."
  breadcrumbs={breadcrumbs}
>
  <section class="blog-hero container">
    <span class="marker">Blog</span>
    <h1>Inspirations et <span class="it">conseils</span>.</h1>
    <p>Guides, lieux, idées et retours d'expérience pour vos événements au Pays Basque, dans les Landes et en Béarn.</p>
  </section>

  <section class="container blog-grid">
    {articles.map((a) => (
      <a href={`/blog/${a.id.replace(/\.mdx$/, '')}/`} class="blog-card">
        {a.data.cover && (
          <div class="blog-card-cover">
            <img src={a.data.cover} alt={a.data.coverAlt ?? ''} loading="lazy" />
          </div>
        )}
        <div class="blog-card-body">
          {a.data.eyebrow && <span class="eyebrow">{a.data.eyebrow}</span>}
          <h2>{a.data.h1}</h2>
          <p>{a.data.description}</p>
          <div class="blog-card-meta">
            <time datetime={a.data.publishedAt.toISOString()}>{formatFr(a.data.publishedAt)}</time>
          </div>
        </div>
      </a>
    ))}
    {articles.length === 0 && <p class="empty">Les premiers articles arrivent très bientôt.</p>}
  </section>
</BaseLayout>

<style>
  .blog-hero {
    padding-block: clamp(60px, 8vw, 100px) clamp(32px, 4vw, 56px);
    text-align: center;
    max-width: 760px;
  }
  .blog-hero .marker { margin-bottom: 20px; justify-content: center; display: inline-flex; }
  .blog-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 20px;
  }
  .blog-hero h1 .it { color: var(--coral-deep); font-weight: 400; }
  .blog-hero p { color: var(--ink-soft); font-size: 18px; max-width: 560px; margin-inline: auto; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
    padding-bottom: clamp(60px, 8vw, 100px);
  }
  .blog-card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 2px rgba(27,18,13,.06), 0 10px 24px -14px rgba(27,18,13,.12);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgba(27,18,13,.08), 0 20px 48px -16px rgba(27,18,13,.2);
  }
  .blog-card-cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cream);
  }
  .blog-card-cover img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .blog-card:hover .blog-card-cover img { transform: scale(1.04); }
  .blog-card-body { padding: 24px 24px 28px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .blog-card-body .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 12px;
    color: var(--coral-deep);
    font-weight: 600;
  }
  .blog-card-body h2 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    line-height: 1.25;
    margin: 0;
  }
  .blog-card-body p { color: var(--ink-soft); font-size: 15px; line-height: 1.55; flex: 1; margin: 0; }
  .blog-card-meta { color: var(--ink-mute); font-size: 13px; margin-top: 4px; }
  .empty { text-align: center; color: var(--ink-mute); grid-column: 1 / -1; padding: 40px 0; }
</style>
