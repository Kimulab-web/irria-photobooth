---
/**
 * Page d'accueil structurée selon la méthode AIDA :
 *  A — Attention  : Hero (headline arrête-scroll, promesse claire)
 *  I — Intérêt    : Comment ça marche + À propos (l'objet, l'histoire)
 *  D — Désir      : Formules + Occasions + Marquee villes (l'offre et où)
 *  A — Action     : Zones + FAQ + CTA finale
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Method from '../components/ui/Method.astro';
import AboutSection from '../components/ui/AboutSection.astro';
import FormulesSection from '../components/ui/FormulesSection.astro';
import Occasions from '../components/ui/Occasions.astro';
import Marquee from '../components/ui/Marquee.astro';
import Zones from '../components/ui/Zones.astro';
import Faq from '../components/ui/Faq.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Contenu manquant : src/content/pages/home.mdx');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  faqs={entry.data.faqs}
>
  {/* A — ATTENTION */}
  <Hero
    title="Une borne"
    titleHighlight="qui fait sourire"
    titleAfter="tous vos invités."
    subtitle="Photobooth au design vintage, installé chez vous avant l'événement et récupéré après. Vous profitez, elle s'occupe des souvenirs."
  />

  {/* I — INTÉRÊT : le fonctionnement, puis l'objet */}
  <Method />
  <AboutSection />

  {/* D — DÉSIR : l'offre, les cas d'usage, la présence territoriale */}
  <FormulesSection />
  <Occasions />
  <Marquee />

  {/* A — ACTION : rassurance géographique, objections, conversion */}
  <Zones />

  {entry.data.faqs && entry.data.faqs.length > 0 && <Faq faqs={entry.data.faqs} />}

  <CtaBanner />
</BaseLayout>
