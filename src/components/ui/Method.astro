---
const steps = [
  {
    titre: 'On échange',
    desc: 'Un mail ou un coup de fil pour caler la date, le lieu et la formule. Réponse sous 24 heures.',
  },
  {
    titre: 'On installe',
    desc: 'La borne arrive quelques heures avant, calée, testée, prête à sourire.',
  },
  {
    titre: 'Vous profitez',
    desc: 'Vos invités déclenchent, choisissent, impriment. Rien à surveiller, rien à gérer.',
  },
  {
    titre: 'On récupère',
    desc: 'Passage le lendemain ou en fin de soirée. Tous les tirages et les fichiers restent à vous.',
  },
];
---

<section id="method" class="method">
  <div class="container">
    <div class="method-head reveal">
      <h2>Comment ça marche <span class="it">?</span></h2>
      <p>Une prestation pensée pour les événements où vous voulez profiter, pas gérer un prestataire de plus le jour J.</p>
    </div>

    <ol class="timeline" aria-label="Étapes de la prestation">
      {steps.map((s, i) => (
        <li class="timeline-step reveal" style={`--reveal-delay: ${i * 120}ms`}>
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-body">
            <h3>{s.titre}</h3>
            <p>{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 90px;
    align-items: end;
  }

  .method-head h2 {
    max-width: 620px;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .method-head h2 .it {
    color: var(--coral-deep);
    font-weight: 400;
  }

  .method-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 420px;
    margin: 0;
  }

  /* ============================================
     TIMELINE — frise horizontale
     Ligne au centre vertical des ronds, du 1er au dernier.
     ============================================ */
  .timeline {
    --cols: 4;
    --gap: 32px;
    --dot-size: 24px;
    --line-thickness: 3px;

    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gap);
    padding: 0;
    margin: 0;
    list-style: none;
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: calc(var(--dot-size) / 2 - var(--line-thickness) / 2);
    left: calc((100% - (var(--cols) - 1) * var(--gap)) / (var(--cols) * 2));
    right: calc((100% - (var(--cols) - 1) * var(--gap)) / (var(--cols) * 2));
    height: var(--line-thickness);
    background: linear-gradient(
      to right,
      var(--coral-soft) 0%,
      var(--coral) 45%,
      var(--coral-deep) 100%
    );
    border-radius: var(--line-thickness);
    z-index: 0;
    /* La ligne se dessine au scroll */
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 1200ms var(--ease-out);
    transition-delay: 200ms;
  }

  /* Une fois qu'au moins une étape est révélée, on trace la ligne */
  .timeline:has(.is-in-view)::before {
    transform: scaleX(1);
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    position: relative;
    z-index: 1;
  }

  .timeline-dot {
    display: block;
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--paper);
    border: 4px solid var(--coral);
    box-shadow: 0 0 0 8px var(--paper), 0 6px 16px -4px rgba(240, 119, 74, 0.4);
    transition: transform 400ms var(--ease-out);
  }

  .timeline-step:hover .timeline-dot {
    transform: scale(1.2);
  }

  /* Progression corail clair → foncé */
  .timeline-step:nth-child(1) .timeline-dot { border-color: var(--coral-soft); }
  .timeline-step:nth-child(2) .timeline-dot { border-color: var(--coral); }
  .timeline-step:nth-child(3) .timeline-dot { border-color: var(--coral); background: var(--coral-soft); }
  .timeline-step:nth-child(4) .timeline-dot {
    border-color: var(--coral-deep);
    background: var(--coral);
  }

  .timeline-body h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
    line-height: 1.1;
  }

  .timeline-body p {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
    max-width: 260px;
  }

  @media (max-width: 960px) {
    .method-head {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    .timeline {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-left: 24px;
    }
    .timeline::before {
      top: calc(var(--dot-size) / 2);
      bottom: calc(var(--dot-size) / 2);
      left: calc(var(--dot-size) / 2 - var(--line-thickness) / 2);
      right: auto;
      width: var(--line-thickness);
      height: auto;
      background: linear-gradient(
        to bottom,
        var(--coral-soft) 0%,
        var(--coral) 45%,
        var(--coral-deep) 100%
      );
      transform-origin: center top;
      transform: scaleY(0);
    }
    .timeline:has(.is-in-view)::before {
      transform: scaleY(1);
    }
    .timeline-step {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 24px;
    }
    .timeline-dot {
      margin-left: calc(-1 * (var(--dot-size) / 2 + 12px));
      flex-shrink: 0;
      box-shadow: 0 0 0 6px var(--paper);
    }
    .timeline-body p {
      max-width: none;
    }
  }
</style>
