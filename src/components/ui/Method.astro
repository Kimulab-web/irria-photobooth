---
const steps = [
  {
    titre: 'On échange',
    desc: 'Un mail ou un coup de fil pour caler la date, le lieu et la formule. Réponse sous 24 heures.',
  },
  {
    titre: 'On installe',
    desc: 'La borne arrive quelques heures avant, calée, testée, prête à sourire.',
  },
  {
    titre: 'Vous profitez',
    desc: 'Vos invités déclenchent, choisissent, impriment. Rien à surveiller, rien à gérer.',
  },
  {
    titre: 'On récupère',
    desc: 'Passage le lendemain ou en fin de soirée. Tous les tirages et les fichiers restent à vous.',
  },
];
---

<section id="method" class="method">
  <div class="container">
    <div class="method-head">
      <h2>Comment ça marche <span class="it">?</span></h2>
      <p>Une prestation pensée pour les événements où vous voulez profiter, pas gérer un prestataire de plus le jour J.</p>
    </div>

    <ol class="timeline" aria-label="Étapes de la prestation">
      {steps.map((s, i) => (
        <li class="timeline-step" style={`--i:${i}`}>
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-body">
            <h3>{s.titre}</h3>
            <p>{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 90px;
    align-items: end;
  }

  .method-head h2 {
    max-width: 620px;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .method-head h2 .it {
    color: var(--coral-deep);
    font-weight: 400;
  }

  .method-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 420px;
    margin: 0;
  }

  /* ============================================
     TIMELINE — 4 étapes en frise horizontale
     ============================================ */
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding: 60px 0 0;
    margin: 0;
    list-style: none;
    position: relative;
  }

  /* La ligne d'évolution : gradient corail clair → foncé,
     qui traverse tous les points et suggère la progression */
  .timeline::before {
    content: "";
    position: absolute;
    top: 60px;
    left: 12%;
    right: 12%;
    height: 3px;
    background: linear-gradient(
      to right,
      var(--coral-soft) 0%,
      var(--coral) 40%,
      var(--coral-deep) 100%
    );
    border-radius: 3px;
    z-index: 0;
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .timeline-dot {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--paper);
    border: 4px solid var(--coral);
    box-shadow: 0 0 0 8px var(--paper), 0 6px 16px -4px rgba(240, 119, 74, 0.4);
    position: relative;
  }

  /* Progression : chaque point s'assombrit un peu vers la fin */
  .timeline-step:nth-child(1) .timeline-dot { border-color: var(--coral-soft); }
  .timeline-step:nth-child(2) .timeline-dot { border-color: var(--coral); }
  .timeline-step:nth-child(3) .timeline-dot { border-color: var(--coral); background: var(--coral-soft); }
  .timeline-step:nth-child(4) .timeline-dot {
    border-color: var(--coral-deep);
    background: var(--coral);
  }

  .timeline-body h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
    line-height: 1.1;
  }

  .timeline-body p {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
    max-width: 260px;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 960px) {
    .method-head {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    .timeline {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 20px 0 0 24px;
    }
    /* Ligne verticale à gauche sur mobile */
    .timeline::before {
      top: 30px;
      bottom: 30px;
      left: 12px;
      right: auto;
      width: 3px;
      height: auto;
      background: linear-gradient(
        to bottom,
        var(--coral-soft) 0%,
        var(--coral) 40%,
        var(--coral-deep) 100%
      );
    }
    .timeline-step {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 24px;
    }
    .timeline-dot {
      margin-left: -25px;
      flex-shrink: 0;
      box-shadow: 0 0 0 6px var(--paper);
    }
    .timeline-body p {
      max-width: none;
    }
  }
</style>
