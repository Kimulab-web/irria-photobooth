---
/**
 * Section Templates — pile scroll-révélée.
 * Les tirages apparaissent un à un, chacun se posant par-dessus les précédents,
 * pour former une pile fanée au centre.
 *
 * - Section haute (200vh) → donne de la "course" au scroll.
 * - Un wrapper sticky garde la pile centrée pendant qu'on scrolle.
 * - Chaque tirage a sa propre spy-marker qui déclenche sa venue.
 */

const templates = [
  { src: '/templates/template-04.jpg', alt: 'Template Atlas Padel — groupe', tilt: -6, x: -22, y: 8 },
  { src: '/templates/template-01.jpg', alt: 'Template Steph 40 ans — mini-strip', tilt: 4, x: 28, y: -14 },
  { src: '/templates/template-03.jpg', alt: 'Template Atlas Padel — strip 3 photos', tilt: -3, x: -40, y: -4 },
  { src: '/templates/template-06.jpg', alt: 'Template Mélina & David — portrait', tilt: 5, x: 48, y: 12 },
  { src: '/templates/template-05.jpg', alt: 'Template Atlas Padel — trio', tilt: -4, x: 10, y: 20 },
  { src: '/templates/template-02.jpg', alt: 'Template Steph 40 ans — portrait', tilt: 6, x: -18, y: -20 },
  { src: '/templates/template-07.jpg', alt: 'Template Mélina & David — strip', tilt: -5, x: 32, y: 6 },
];
---

<section id="templates" class="templates-band">
  <div class="container templates-head reveal">
    <span class="marker">Exemples</span>
    <h2>Un template personnalisé pour <span class="it">chaque événement</span>.</h2>
    <p>Vos couleurs, vos prénoms, votre date, votre logo. Chaque tirage devient un souvenir signé, qu'on garde bien plus longtemps que le gâteau.</p>
  </div>

  <div class="pile-stage" aria-hidden="false">
    <div class="pile-sticky">
      <div class="pile">
        {templates.map((t, i) => (
          <figure
            class="pile-item"
            data-index={i}
            style={`--i: ${i}; --tilt: ${t.tilt}deg; --x: ${t.x}px; --y: ${t.y}px; --z: ${i};`}
          >
            <img src={t.src} alt={t.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>

    {/* Spy markers — un par tirage, répartis sur la hauteur du stage */}
    {templates.map((_, i) => (
      <div class="spy" data-spy={i} aria-hidden="true"></div>
    ))}
  </div>
</section>

<style>
  .templates-band {
    background: var(--cream-pale);
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px) 0;
  }

  /* Ornements corail */
  .templates-band::before,
  .templates-band::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 119, 74, 0.16) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .templates-band::before { top: 40px; left: -100px; }
  .templates-band::after  { bottom: 40px; right: -100px; }

  .templates-head {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .templates-head .marker { margin-bottom: 24px; justify-content: center; }
  .templates-head h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 20px;
  }
  .templates-head h2 .it { color: var(--coral-deep); font-weight: 400; }
  .templates-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 560px;
    margin-inline: auto;
  }

  /* ---------- Pile stage ---------- */
  .pile-stage {
    position: relative;
    /* Course de scroll : 180vh = 1.8 écran de scroll pour parcourir toute la pile */
    height: 180vh;
    margin-top: clamp(40px, 6vw, 80px);
  }

  .pile-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    overflow: visible;
  }

  .pile {
    position: relative;
    width: min(70vw, 420px);
    aspect-ratio: 1 / 1;
  }

  .pile-item {
    position: absolute;
    inset: 0;
    margin: auto;
    z-index: var(--z, 1);
    width: 100%;
    max-width: 100%;
    display: grid;
    place-items: center;

    /* État initial : sous l'écran, inclinée, invisible */
    opacity: 0;
    transform:
      translate(0, 60vh)
      rotate(calc(var(--tilt, 0deg) * 3))
      scale(0.6);

    transition:
      opacity 700ms var(--ease-out),
      transform 900ms var(--ease-out);
    will-change: transform, opacity;
  }

  .pile-item.in {
    opacity: 1;
    transform:
      translate(var(--x, 0), var(--y, 0))
      rotate(var(--tilt, 0deg))
      scale(1);
  }

  .pile-item img {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow:
      0 12px 24px -10px rgba(27, 18, 13, 0.3),
      0 32px 60px -24px rgba(27, 18, 13, 0.4);
  }

  /* Spy markers — invisibles mais déclenchent le reveal au scroll */
  .spy {
    position: absolute;
    left: 0; right: 0;
    width: 100%;
    height: 1px;
    pointer-events: none;
  }
  /* Répartis sur toute la hauteur du stage, échelonnés */
  .spy[data-spy="0"] { top: 10%; }
  .spy[data-spy="1"] { top: 22%; }
  .spy[data-spy="2"] { top: 34%; }
  .spy[data-spy="3"] { top: 46%; }
  .spy[data-spy="4"] { top: 58%; }
  .spy[data-spy="5"] { top: 70%; }
  .spy[data-spy="6"] { top: 82%; }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .pile-stage {
      height: auto;
      margin-top: 40px;
    }
    .pile-sticky {
      position: static;
      height: auto;
      padding-block: 40px;
    }
    .pile {
      aspect-ratio: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
      width: 100%;
      max-width: 1000px;
    }
    .pile-item {
      position: static;
      opacity: 1;
      transform: none;
      transition: none;
      width: auto;
      max-width: 280px;
    }
    .spy { display: none; }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 720px) {
    .pile-stage {
      height: 160vh;
    }
    .pile {
      width: min(78vw, 320px);
    }
    .pile-item img {
      max-height: 60vh;
    }
  }
</style>

<script>
  /**
   * Révèle les tirages un par un quand chaque spy entre dans le viewport
   * (en se concentrant sur le milieu vertical pour une sensation "pile qui monte").
   */
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('.pile-item');
  const spies = document.querySelectorAll<HTMLElement>('.spy[data-spy]');

  if (prefersReduced) {
    items.forEach((it) => it.classList.add('in'));
  } else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = parseInt(
              (entry.target as HTMLElement).dataset.spy ?? '0',
              10,
            );
            const target = items[idx];
            if (target) target.classList.add('in');
            observer.unobserve(entry.target);
          }
        }
      },
      {
        /* On déclenche quand le spy atteint le milieu du viewport */
        rootMargin: '-50% 0px -40% 0px',
        threshold: 0,
      },
    );
    spies.forEach((spy) => observer.observe(spy));
  } else {
    items.forEach((it) => it.classList.add('in'));
  }
</script>
