---
/**
 * Section Templates, fan reveal.
 * Les 7 tirages sont groupés au centre au départ. Quand la section entre
 * dans le viewport, ils s'étalent en arc comme une main de cartes.
 * Au survol d'un tirage, il revient au centre + grossit, les autres
 * s'estompent légèrement.
 */

/* Positions finales dans l'arc (coordonnées en px à l'intérieur du stage).
   Mathématiquement un arc horizontal : largeur ±460px, profondeur de -40 (haut)
   à +180 (bas) pour un effet "main de cartes".
   `tilt` suit la position angulaire pour que chaque carte "pointe" vers le centre. */
const templates = [
  { src: '/templates/template-04.jpg', alt: 'Template Atlas Padel, groupe', x: -460, y: 180, tilt: -18 },
  { src: '/templates/template-01.jpg', alt: 'Template Steph 40 ans, mini-strip', x: -310, y: 60, tilt: -12 },
  { src: '/templates/template-03.jpg', alt: 'Template Atlas Padel, strip 3 photos', x: -160, y: -30, tilt: -6 },
  { src: '/templates/template-06.jpg', alt: 'Template Mélina & David, portrait', x: 0, y: -60, tilt: 0 },
  { src: '/templates/template-05.jpg', alt: 'Template Atlas Padel, trio', x: 160, y: -30, tilt: 6 },
  { src: '/templates/template-02.jpg', alt: 'Template Steph 40 ans, portrait', x: 310, y: 60, tilt: 12 },
  { src: '/templates/template-07.jpg', alt: 'Template Mélina & David, strip', x: 460, y: 180, tilt: 18 },
];
---

<section id="templates" class="templates-band">
  <div class="container templates-head reveal">
    <span class="marker">Exemples</span>
    <h2>Un template personnalisé pour <span class="it">chaque événement</span>.</h2>
    <p>Vos couleurs, vos prénoms, votre date, votre logo. Chaque tirage devient un souvenir signé, qu'on garde bien plus longtemps que le gâteau.</p>
  </div>

  <div class="fan-stage">
    <div class="fan">
      {templates.map((t, i) => (
        <figure
          class="fan-card"
          data-index={i}
          style={`--i: ${i}; --x: ${t.x}px; --y: ${t.y}px; --tilt: ${t.tilt}deg; --z: ${i};`}
        >
          <img src={t.src} alt={t.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .templates-band {
    background: var(--cream-pale);
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px);
  }

  .templates-band::before,
  .templates-band::after {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 119, 74, 0.16) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .templates-band::before { top: 40px; left: -120px; }
  .templates-band::after  { bottom: 40px; right: -120px; }

  .templates-head {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .templates-head .marker { margin-bottom: 24px; justify-content: center; }
  .templates-head h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 20px;
  }
  .templates-head h2 .it { color: var(--coral-deep); font-weight: 400; }
  .templates-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 560px;
    margin-inline: auto;
  }

  /* ---------- Fan stage ---------- */
  .fan-stage {
    position: relative;
    z-index: 1;
    margin-top: clamp(40px, 6vw, 80px);
    display: grid;
    place-items: center;
    min-height: min(680px, 85vh);
    padding-block: 20px;
    perspective: 1200px;
  }

  .fan {
    position: relative;
    width: min(100%, 1100px);
    height: 100%;
    min-height: 560px;
    display: grid;
    place-items: center;
  }

  .fan-card {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    z-index: var(--z, 1);
    width: 240px;

    /* État initial : tous au centre, scale réduit, sans tilt, invisible */
    opacity: 0;
    transform:
      translate(-50%, -50%)
      rotate(0deg)
      scale(0.6);

    transition:
      opacity 700ms var(--ease-out),
      transform 1100ms cubic-bezier(0.18, 0.9, 0.32, 1.3),
      filter 350ms var(--ease-out);

    will-change: transform, opacity;
    cursor: pointer;
  }

  /* État révélé : chaque carte à sa position dans l'arc */
  .fan-card.in {
    opacity: 1;
    transform:
      translate(calc(-50% + var(--x, 0px)), calc(-50% + var(--y, 0px)))
      rotate(var(--tilt, 0deg))
      scale(1);
  }

  .fan-card img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 340px;
    object-fit: contain;
    border-radius: 6px;
    box-shadow:
      0 10px 20px -8px rgba(27, 18, 13, 0.3),
      0 28px 56px -22px rgba(27, 18, 13, 0.42);
  }

  /* Hover : la carte survolée revient au centre, grossit, passe au-dessus.
     Les autres s'estompent légèrement. */
  .fan:hover .fan-card.in {
    filter: brightness(0.75) saturate(0.9);
  }
  .fan-card.in:hover {
    z-index: 100;
    /* Reste à sa position dans l'arc mais se redresse + grossit , 
       pas de translate au centre, sinon la carte quitte le curseur et flickr. */
    transform:
      translate(calc(-50% + var(--x, 0px)), calc(-50% + var(--y, 0px) - 12px))
      rotate(0deg)
      scale(1.12);
    filter: brightness(1) saturate(1) !important;
    transition:
      transform 400ms cubic-bezier(0.2, 0.9, 0.25, 1.1),
      filter 250ms var(--ease-out);
  }
  .fan-card.in:hover img {
    box-shadow:
      0 20px 30px -10px rgba(27, 18, 13, 0.4),
      0 40px 80px -24px rgba(27, 18, 13, 0.5);
  }

  /* ---------- Reduced motion / fallback ---------- */
  @media (prefers-reduced-motion: reduce) {
    .fan-stage {
      min-height: auto;
      padding-block: 20px;
    }
    .fan {
      min-height: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }
    .fan-card {
      position: static;
      opacity: 1;
      transform: none;
      transition: none;
      width: 240px;
    }
    .fan:hover .fan-card.in {
      filter: none;
    }
    .fan-card.in:hover {
      transform: scale(1.05);
    }
  }

  /* ---------- Tablette : réduire l'arc et la taille des cartes ---------- */
  @media (max-width: 1100px) {
    .fan-card { width: 200px; }
    .fan-card img { max-height: 300px; }
    .fan-card.in {
      transform:
        translate(calc(-50% + var(--x, 0px) * 0.72), calc(-50% + var(--y, 0px) * 0.9))
        rotate(var(--tilt, 0deg))
        scale(1);
    }
  }

  @media (max-width: 820px) {
    .fan-card { width: 170px; }
    .fan-card img { max-height: 260px; }
    .fan-stage { min-height: 540px; }
    .fan { min-height: 440px; }
    .fan-card.in {
      transform:
        translate(calc(-50% + var(--x, 0px) * 0.5), calc(-50% + var(--y, 0px) * 0.72))
        rotate(var(--tilt, 0deg))
        scale(1);
    }
  }

  /* ---------- Mobile : bascule en grille mosaïque simple ---------- */
  @media (max-width: 640px) {
    .fan-stage {
      min-height: auto;
      perspective: none;
    }
    .fan {
      min-height: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
      padding-block: 20px;
    }
    .fan-card {
      position: static;
      width: min(80vw, 300px);
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    .fan-card.in {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .fan:hover .fan-card.in { filter: none; }
    .fan-card.in:hover {
      transform: scale(1.03);
    }
  }
</style>

<script>
  /**
   * Quand le fan entre dans le viewport, chaque carte prend sa position
   * en séquence (stagger 90ms).
   */
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fan = document.querySelector<HTMLElement>('.fan');
  const cards = document.querySelectorAll<HTMLElement>('.fan-card');

  if (!fan || !cards.length) {
    // noop
  } else if (prefersReduced || !('IntersectionObserver' in window)) {
    cards.forEach((c) => c.classList.add('in'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            cards.forEach((card, i) => {
              setTimeout(() => card.classList.add('in'), i * 90);
            });
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(fan);
  }
</script>
