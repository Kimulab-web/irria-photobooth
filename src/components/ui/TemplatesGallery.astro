---
/**
 * Section Templates — pile qui se construit automatiquement quand la section
 * entre dans le viewport. Pas de scroll-driven : juste un IntersectionObserver
 * qui déclenche la séquence une fois.
 */

const templates = [
  { src: '/templates/template-04.jpg', alt: 'Template Atlas Padel — groupe', tilt: -6, x: -22, y: 8 },
  { src: '/templates/template-01.jpg', alt: 'Template Steph 40 ans — mini-strip', tilt: 4, x: 28, y: -14 },
  { src: '/templates/template-03.jpg', alt: 'Template Atlas Padel — strip 3 photos', tilt: -3, x: -40, y: -4 },
  { src: '/templates/template-06.jpg', alt: 'Template Mélina & David — portrait', tilt: 5, x: 48, y: 12 },
  { src: '/templates/template-05.jpg', alt: 'Template Atlas Padel — trio', tilt: -4, x: 10, y: 20 },
  { src: '/templates/template-02.jpg', alt: 'Template Steph 40 ans — portrait', tilt: 6, x: -18, y: -20 },
  { src: '/templates/template-07.jpg', alt: 'Template Mélina & David — strip', tilt: -5, x: 32, y: 6 },
];
---

<section id="templates" class="templates-band">
  <div class="container templates-head reveal">
    <span class="marker">Exemples</span>
    <h2>Un template personnalisé pour <span class="it">chaque événement</span>.</h2>
    <p>Vos couleurs, vos prénoms, votre date, votre logo. Chaque tirage devient un souvenir signé, qu'on garde bien plus longtemps que le gâteau.</p>
  </div>

  <div class="pile-wrap">
    <div class="pile">
      {templates.map((t, i) => (
        <figure
          class="pile-item"
          data-index={i}
          style={`--i: ${i}; --tilt: ${t.tilt}deg; --x: ${t.x}px; --y: ${t.y}px; --z: ${i};`}
        >
          <img src={t.src} alt={t.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .templates-band {
    background: var(--cream-pale);
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px);
  }

  .templates-band::before,
  .templates-band::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 119, 74, 0.16) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .templates-band::before { top: 40px; left: -100px; }
  .templates-band::after  { bottom: 40px; right: -100px; }

  .templates-head {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .templates-head .marker { margin-bottom: 24px; justify-content: center; }
  .templates-head h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 20px;
  }
  .templates-head h2 .it { color: var(--coral-deep); font-weight: 400; }
  .templates-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 560px;
    margin-inline: auto;
  }

  /* ---------- Pile ---------- */
  .pile-wrap {
    position: relative;
    z-index: 1;
    margin-top: clamp(40px, 6vw, 80px);
    display: grid;
    place-items: center;
    min-height: min(640px, 80vh);
    padding-block: 40px;
  }

  .pile {
    position: relative;
    width: min(70vw, 420px);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }

  .pile-item {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    z-index: var(--z, 1);
    width: 100%;
    display: grid;
    place-items: center;

    /* État initial : sous l'écran, inclinée, réduite, invisible */
    opacity: 0;
    transform:
      translate(-50%, calc(-50% + 80px))
      rotate(calc(var(--tilt, 0deg) * 3))
      scale(0.75);

    transition:
      opacity 650ms var(--ease-out),
      transform 750ms var(--ease-out);
    will-change: transform, opacity;
  }

  .pile-item.in {
    opacity: 1;
    transform:
      translate(calc(-50% + var(--x, 0)), calc(-50% + var(--y, 0)))
      rotate(var(--tilt, 0deg))
      scale(1);
  }

  .pile-item img {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow:
      0 12px 24px -10px rgba(27, 18, 13, 0.3),
      0 32px 60px -24px rgba(27, 18, 13, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .pile-wrap {
      min-height: auto;
    }
    .pile {
      aspect-ratio: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
      width: 100%;
      max-width: 1000px;
    }
    .pile-item {
      position: static;
      opacity: 1;
      transform: none;
      transition: none;
      width: auto;
      max-width: 280px;
    }
  }

  @media (max-width: 720px) {
    .pile-wrap {
      min-height: 70vh;
    }
    .pile {
      width: min(80vw, 320px);
    }
    .pile-item img {
      max-height: 55vh;
    }
  }
</style>

<script>
  /**
   * Quand la pile entre dans le viewport, chaque tirage apparaît un par un
   * (stagger de 350ms), se posant par-dessus les précédents.
   */
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pile = document.querySelector<HTMLElement>('.pile');
  const items = document.querySelectorAll<HTMLElement>('.pile-item');

  if (!pile || !items.length) {
    // noop
  } else if (prefersReduced || !('IntersectionObserver' in window)) {
    items.forEach((it) => it.classList.add('in'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            items.forEach((item, i) => {
              setTimeout(() => item.classList.add('in'), i * 350);
            });
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(pile);
  }
</script>
