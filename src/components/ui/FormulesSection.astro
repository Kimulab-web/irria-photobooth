---
import { formules } from '../../data/formules';
import FormuleRow from './FormuleRow.astro';

interface Props {
  showHead?: boolean;
}

const { showHead = true } = Astro.props;
---

<section id="formules" class="formules-band">
  <div class="container">
    {showHead && (
      <div class="formules-head reveal">
        <div>
          <span class="marker">Formules</span>
          <h2>Quatre formats, un même <span class="it">savoir-faire</span>.</h2>
        </div>
        <p>Une formule sans tirage pour l'ambiance seule, puis trois volumes de tirages selon la taille de votre événement.</p>
      </div>
    )}
    <div class="formules-list">
      {formules.map((f, i) => (
        <div class="reveal" style={`--reveal-delay: ${i * 120}ms`}>
          <FormuleRow formule={f} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .formules-band {
    background: var(--cream);
  }

  .formules-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    margin-bottom: 60px;
    align-items: end;
  }

  .formules-head h2 {
    margin-top: 24px;
  }

  .formules-head p {
    color: var(--ink-soft);
    font-size: 18px;
    max-width: 460px;
    margin: 0;
  }

  .formules-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 900px) {
    .formules-head {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
  }
</style>
