---
/**
 * Bloc emphase pour la page Livre d'or vidéo — phrase-clé en grand.
 */
interface Props {
  before?: string;
  highlight: string;
  after?: string;
}
const { before, highlight, after } = Astro.props;
---

<aside class="ldv-quote">
  <svg class="ldv-quote-mark" width="48" height="36" viewBox="0 0 48 36" fill="none" aria-hidden="true">
    <path d="M14 36c-7.732 0-14-6.268-14-14 0-13.255 11.193-22 22-22v8c-7.18 0-13 4.82-13 12 0 0 1 1 5 1v15H14z" fill="currentColor"/>
    <path d="M38 36c-7.732 0-14-6.268-14-14C24 8.745 35.193 0 46 0v8c-7.18 0-13 4.82-13 12 0 0 1 1 5 1v15H38z" fill="currentColor"/>
  </svg>
  <p>
    {before}
    {' '}
    <strong>{highlight}</strong>
    {after && ' ' }
    {after}
  </p>
</aside>

<style>
  .ldv-quote {
    position: relative;
    margin: 56px 0;
    padding: 44px 36px 36px;
    background: var(--ink);
    color: var(--cream-pale);
    border-radius: 16px;
    text-align: center;
    overflow: hidden;
  }

  .ldv-quote::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 20%, rgba(240, 119, 74, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(240, 119, 74, 0.12) 0%, transparent 50%);
    pointer-events: none;
  }

  .ldv-quote-mark {
    display: block;
    margin: 0 auto 18px;
    color: var(--coral);
    opacity: 0.9;
    position: relative;
    z-index: 1;
  }

  .ldv-quote p {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 2.1rem) !important;
    line-height: 1.3 !important;
    margin: 0 !important;
    color: var(--cream-pale) !important;
    letter-spacing: -0.005em;
    max-width: 680px;
    margin-inline: auto !important;
  }
  .ldv-quote strong {
    color: var(--coral);
    font-weight: 500;
    font-style: italic;
  }

  @media (max-width: 720px) {
    .ldv-quote {
      padding: 36px 24px 28px;
      margin: 40px 0;
    }
  }
</style>
