---
interface Props {
  band?: 'paper' | 'cream';
}

const { band = 'paper' } = Astro.props;
---

<section class:list={['highlight-band', `band-${band}`]}>
  <div class="container">
    <blockquote class="highlight reveal reveal-scale">
      <span class="quote-mark" aria-hidden="true">“</span>
      <p><slot /></p>
    </blockquote>
  </div>
</section>

<style>
  .band-paper { background: var(--paper); }
  .band-cream { background: var(--cream); }

  .highlight-band {
    padding-block: clamp(60px, 8vw, 100px);
  }

  .highlight {
    max-width: 900px;
    margin: 0 auto;
    padding: 0;
    text-align: center;
    position: relative;
  }

  .quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 400;
    font-size: 120px;
    color: var(--coral-soft);
    line-height: 0.7;
    height: 60px;
    margin-bottom: 8px;
  }

  .highlight p {
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .highlight :global(strong) {
    font-weight: 700;
    font-style: normal;
    color: var(--coral-deep);
  }
</style>
