---
import { zones } from '../../data/villes';

interface Props {
  intro?: string;
}

const {
  intro = 'Livraison incluse dans un rayon de 40 km depuis Hasparren. Au-delà, 0,80 € par kilomètre.',
} = Astro.props;
---

<section id="zones" class="zones-band">
  <div class="container">
    <div class="zones-head">
      <span class="marker on-dark">Où nous intervenons</span>
      <h2>Toute la côte, l'intérieur, et <span class="it">au-delà</span>.</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="zones-grid">
      {zones.map((zone) => (
        <div class="zone-block">
          <h3 class="zone-region">{zone.region}</h3>
          <ul class="zone-villes">
            {zone.villes.map((v) => <li>{v}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="zones-note">Votre commune n'est pas listée ? Demandez, la plupart du temps c'est possible.</p>
  </div>
</section>

<style>
  .zones-band {
    background: var(--ink);
    color: var(--paper);
  }

  .zones-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 70px;
  }

  .zones-head h2 {
    color: var(--paper);
    margin-top: 20px;
  }

  .zones-head h2 .it {
    color: var(--coral);
    font-weight: 400;
  }

  .zones-head p {
    color: rgba(246, 233, 206, 0.65);
    font-size: 17px;
    margin-top: 20px;
    max-width: 560px;
    margin-inline: auto;
  }

  .zones-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-block: 12px;
    border-top: 1px solid rgba(246, 233, 206, 0.15);
    border-bottom: 1px solid rgba(246, 233, 206, 0.15);
  }

  .zone-block {
    padding: 24px 0;
  }

  .zone-block:not(:last-child) {
    border-right: 1px solid rgba(246, 233, 206, 0.12);
    padding-right: 40px;
  }

  .zone-region {
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 400;
    font-size: 26px;
    color: var(--coral-soft);
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }

  .zone-villes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 24px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.005em;
  }

  .zone-block:nth-child(2) .zone-villes,
  .zone-block:nth-child(3) .zone-villes {
    grid-template-columns: 1fr;
  }

  .zone-villes li {
    color: var(--paper);
    transition: color 0.2s;
  }

  .zones-note {
    text-align: center;
    margin-top: 48px;
    color: rgba(246, 233, 206, 0.55);
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-size: 17px;
  }

  @media (max-width: 900px) {
    .zones-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .zone-block:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid rgba(246, 233, 206, 0.12);
      padding-right: 0;
      padding-bottom: 24px;
      margin-bottom: 0;
    }
    .zone-villes {
      grid-template-columns: 1fr 1fr !important;
    }
  }

  @media (max-width: 480px) {
    .zone-villes {
      grid-template-columns: 1fr !important;
    }
  }
</style>
