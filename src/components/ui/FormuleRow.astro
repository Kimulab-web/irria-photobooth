---
import type { Formule } from '../../data/formules';

interface Props {
  formule: Formule;
}

const { formule } = Astro.props;
---

<article class={`formule ${formule.featured ? 'featured' : ''} ${formule.slug === 'autonome' ? 'zero' : ''}`} id={formule.slug}>
  <div class="formule-count">{formule.count}</div>
  <div class="formule-name">
    {formule.featured && <span class="badge">Le plus complet</span>}
    {formule.nom}
    <small>{formule.sousTitre}</small>
  </div>
  <div class="formule-desc">{formule.cible}</div>
  <a href={`/contact/?formule=${formule.slug}`} class="cta">
    Demander un devis <span class="arrow">→</span>
  </a>
</article>

<style>
  .formule {
    display: grid;
    grid-template-columns: 130px 1.2fr 1.4fr auto;
    gap: 40px;
    align-items: center;
    padding: 36px 0;
    border-top: 1px solid var(--line);
    transition: padding-left 0.25s;
  }
  .formule:last-child {
    border-bottom: 1px solid var(--line);
  }
  .formule:hover {
    padding-left: 12px;
  }

  .formule-count {
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    color: var(--coral-deep);
    letter-spacing: -0.03em;
  }

  .formule.zero .formule-count {
    font-size: 48px;
    color: var(--ink-mute);
  }

  .formule-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .formule-name small {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 6px;
    letter-spacing: 0;
  }

  .formule-desc {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.5;
  }

  .formule.featured {
    background: var(--ink);
    color: var(--paper);
    padding: 44px 32px;
    margin: 8px -32px;
    border-radius: 24px;
    border: none;
  }
  .formule.featured + .formule {
    border-top: none;
  }
  .formule.featured .formule-count {
    color: var(--coral);
  }
  .formule.featured .formule-name {
    color: var(--paper);
  }
  .formule.featured .formule-name small {
    color: var(--coral-soft);
  }
  .formule.featured .formule-desc {
    color: rgba(246, 233, 206, 0.75);
  }
  .formule.featured .badge {
    display: inline-block;
    background: var(--coral);
    color: var(--paper);
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .formule .cta {
    justify-self: end;
    font-family: var(--font-heading);
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    font-weight: 600;
    font-size: 17px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1.5px solid currentColor;
    transition: color 0.2s;
  }
  .formule .cta:hover {
    color: var(--coral-deep);
  }
  .formule.featured .cta:hover {
    color: var(--coral-soft);
  }
  .formule .cta:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .formule {
      grid-template-columns: 90px 1fr;
      gap: 20px 24px;
    }
    .formule .formule-desc {
      grid-column: 2;
    }
    .formule .cta {
      grid-column: 2;
      justify-self: start;
    }
    .formule-count {
      font-size: 46px;
    }
    .formule.zero .formule-count {
      font-size: 34px;
    }
    .formule-name {
      font-size: 24px;
    }
    .formule.featured {
      padding: 32px 24px;
    }
  }

  @media (max-width: 560px) {
    .formule.featured {
      margin: 8px -20px;
      padding: 32px 20px;
    }
  }
</style>
