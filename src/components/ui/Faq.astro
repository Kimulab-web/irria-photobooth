---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  titleHighlight?: string;
  intro?: string;
}

const {
  faqs,
  title = 'Ce qu\'on nous',
  titleHighlight = 'demande le plus',
  intro = 'Une réponse rapide aux questions qui reviennent. Pour le reste, un mot suffit.',
} = Astro.props;
---

<section id="faq" class="faq-section">
  <div class="container">
    <div class="faq-head reveal">
      <div>
        <span class="marker">Questions fréquentes</span>
        <h2>{title} <span class="it">{titleHighlight}</span>.</h2>
      </div>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq">
      {faqs.map((faq, i) => (
        <details open={i === 0} class="reveal" style={`--reveal-delay: ${i * 80}ms`}>
          <summary>
            {faq.question}
            <span class="toggle">+</span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
    align-items: end;
  }

  .faq-head h2 {
    max-width: 560px;
    margin-top: 24px;
  }

  .faq-head p {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 400px;
    margin: 0;
  }

  .faq {
    max-width: 900px;
    margin: 0 auto;
  }

  .faq details {
    border-top: 1px solid var(--line);
    padding: 26px 0;
    transition: padding-left 0.25s ease;
  }

  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq details:hover {
    padding-left: 12px;
  }

  .faq summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.01em;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .faq summary:hover {
    color: var(--coral-deep);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary .toggle {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cream);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 20px;
    line-height: 1;
    color: var(--coral-deep);
    transition: transform 300ms var(--ease-out), background 300ms var(--ease-out), color 300ms var(--ease-out);
  }

  .faq details[open] summary .toggle {
    transform: rotate(45deg);
    background: var(--coral);
    color: var(--paper);
  }

  .faq details p {
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 16px;
    max-width: 780px;
    line-height: 1.65;
    animation: faqOpen 400ms var(--ease-out) both;
  }

  @keyframes faqOpen {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .faq-head {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    .faq summary {
      font-size: 19px;
    }
  }
</style>
