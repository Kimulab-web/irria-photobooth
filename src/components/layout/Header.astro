---
const navItems = [
  { label: 'Formules', href: '/nos-formules/' },
  { label: 'Mariage', href: '/photobooth-mariage-pays-basque/' },
  { label: 'Entreprise', href: '/photobooth-entreprise-pays-basque/' },
  { label: 'Anniversaire', href: '/photobooth-anniversaire/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Irria Photobooth, accueil">
      <img src="/logo-irria-coral.png" alt="Irria" class="site-header__logo" width="200" height="200" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Ouvrir le menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-header__nav" aria-label="Navigation principale">
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li class="site-header__nav-cta">
          <a href="/contact/" class="btn coral">Réserver</a>
        </li>
      </ul>
    </nav>

    <a href="/contact/" class="btn coral site-header__cta">Réserver</a>
  </div>
</header>

<style>
  .site-header {
    background: rgba(251, 243, 225, 0.9);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 10px;
    position: relative;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
  }

  .site-header__logo {
    height: 72px;
    width: auto;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    transition: color 0.2s;
  }

  .site-header__nav a:not(.btn):hover {
    color: var(--coral-deep);
  }

  .site-header__nav-cta {
    display: none;
  }

  .site-header__nav .btn {
    padding: 12px 22px;
    font-size: 14px;
  }

  .site-header__cta {
    padding: 12px 22px;
    font-size: 14px;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
  }

  @media (max-width: 900px) {
    .site-header__logo {
      height: 56px;
    }
    .site-header__toggle {
      display: flex;
    }

    .site-header__cta {
      display: none;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }

    .site-header__nav.is-open {
      display: block;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.5rem 1.5rem 1.5rem;
    }

    .site-header__nav li {
      width: 100%;
      padding-block: 0.7rem;
      border-bottom: 1px solid var(--line);
    }

    .site-header__nav-cta {
      display: block;
      border-bottom: none;
      padding-top: 1rem;
    }

    .site-header__nav-cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  }
</script>
