---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow?: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  cover?: string;
  coverAlt?: string;
  slug: string;
}

const {
  title,
  description,
  h1,
  eyebrow = 'Blog',
  publishedAt,
  updatedAt,
  author,
  cover,
  coverAlt,
  slug,
} = Astro.props;

const canonicalURL = new URL(`/blog/${slug}/`, Astro.site);

const breadcrumbs = [
  { name: 'Accueil', url: 'https://irria-photobooth.fr/' },
  { name: 'Blog', url: 'https://irria-photobooth.fr/blog/' },
  { name: h1, url: canonicalURL.toString() },
];

const formatFr = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  image: cover ? new URL(cover, Astro.site).toString() : undefined,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://irria-photobooth.fr/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Irria Photobooth',
    logo: {
      '@type': 'ImageObject',
      url: 'https://irria-photobooth.fr/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={cover}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="article-page">
    <header class="article-hero container">
      <a href="/blog/" class="article-back">← Tous les articles</a>
      {eyebrow && <span class="marker">{eyebrow}</span>}
      <h1>{h1}</h1>
      <div class="article-meta">
        <span>Par <strong>{author}</strong></span>
        <span class="dot">·</span>
        <time datetime={publishedAt.toISOString()}>{formatFr(publishedAt)}</time>
        {updatedAt && (
          <>
            <span class="dot">·</span>
            <span class="updated">Mis à jour le {formatFr(updatedAt)}</span>
          </>
        )}
      </div>
    </header>

    {cover && (
      <div class="article-cover container">
        <img src={cover} alt={coverAlt ?? ''} loading="eager" />
      </div>
    )}

    <section class="container article-body-wrap">
      <div class="prose article-prose">
        <slot />
      </div>
    </section>

    <section class="article-cta">
      <div class="container">
        <p class="eyebrow">On parle photobooth ?</p>
        <h2>Un projet d'événement au Pays Basque ?</h2>
        <p class="sub">Envoyez-nous votre date et le lieu. Réponse sous 24 heures, devis personnalisé.</p>
        <a href="/contact/" class="btn">Demander un devis</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding-top: clamp(60px, 8vw, 100px);
    padding-bottom: clamp(32px, 4vw, 48px);
    text-align: center;
    max-width: 820px;
  }
  .article-back {
    display: inline-block;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 20px;
    transition: color 180ms ease;
  }
  .article-back:hover { color: var(--coral-deep); }
  .article-hero .marker {
    display: inline-flex;
    margin-bottom: 20px;
  }
  .article-hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .article-meta {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--ink-mute);
    font-size: 15px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .article-meta .dot { opacity: 0.5; }

  .article-cover {
    margin-bottom: clamp(32px, 4vw, 56px);
    max-width: 980px;
  }
  .article-cover img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 20px 60px -24px rgba(27, 18, 13, 0.3);
  }

  .article-body-wrap {
    padding-bottom: clamp(60px, 8vw, 100px);
  }
  .article-prose {
    max-width: 760px;
    margin-inline: auto;
  }
  .article-prose :global(h2) {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    margin-top: 2.4em;
    margin-bottom: 0.6em;
    line-height: 1.2;
  }
  .article-prose :global(h3) {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.3rem;
    margin-top: 1.8em;
    margin-bottom: 0.4em;
  }
  .article-prose :global(p),
  .article-prose :global(li) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .article-prose :global(a) {
    color: var(--coral-deep);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .article-prose :global(blockquote) {
    border-left: 3px solid var(--coral);
    padding: 4px 0 4px 20px;
    margin: 24px 0;
    color: var(--ink);
    font-style: italic;
  }

  .article-cta {
    background: var(--cream-pale);
    padding-block: clamp(60px, 8vw, 100px);
    text-align: center;
  }
  .article-cta .eyebrow {
    color: var(--coral-deep);
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .article-cta h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 16px;
  }
  .article-cta .sub {
    color: var(--ink-soft);
    max-width: 520px;
    margin: 0 auto 32px;
  }
</style>
