---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import SchemaFAQPage from '../components/seo/SchemaFAQPage.astro';
import SchemaBreadcrumbList from '../components/seo/SchemaBreadcrumbList.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  faqs?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  ogImage = '/logo-irria-coral.png',
  faqs,
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const pageTitle = title.includes('Irria Photobooth') ? title : `${title} | Irria Photobooth`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-irria-coral.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Irria Photobooth" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,600;1,9..144,700;1,9..144,900&family=Lato:wght@300;400;700&display=swap"
    />

    <SchemaLocalBusiness />
    {faqs && faqs.length > 0 && <SchemaFAQPage faqs={faqs} />}
    {breadcrumbs && breadcrumbs.length > 0 && <SchemaBreadcrumbList items={breadcrumbs} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
